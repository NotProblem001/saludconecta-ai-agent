# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN - SISTEMA AGÉNTICO SALUDCONECTA
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Proveedor de LLM (Opción A: GitHub Models / Azure AI Inference)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_tu_token_aqui_personal_access_token
GITHUB_BASE_URL=https://models.inference.ai.azure.com
MODEL_NAME=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Proveedor de LLM alternativo (Opción B: OpenAI API directa)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-tu-api-key-de-openai
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Otras opciones de LLM. Prioridad: OpenRouter, OpenAI, GitHub Models, Groq.
# Sin credenciales válidas el agente usa el planificador por reglas.
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-tu-token
# GROQ_API_KEY=tu-api-key

# ------------------------------------------------------------------------------
# 3. Configuración del Pipeline RAG (ChromaDB + Embeddings)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=text-embedding-3-small
RAG_SIMILARITY_THRESHOLD=0.75
CHROMA_PERSIST_DIRECTORY=./chroma_db

# ------------------------------------------------------------------------------
# 4. Configuración Mock HIS (Base SQLite y Datos)
# ------------------------------------------------------------------------------
DB_PATH=./saludconecta_his.db
COMPROBANTES_DIR=./comprobantes
